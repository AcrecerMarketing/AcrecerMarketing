# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Seguridad ──────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar_por_secreto_largo_aleatorio_minimo_32_chars
CERT_ENCRYPTION_KEY=cambiar_por_clave_aes256_32_bytes_hex

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_PATH=./factura-uy.db

# ── DGI Modo ───────────────────────────────────────────────────────────────────
# mock         → simulador local (sin credenciales DGI reales)
# homologacion → ambiente de pruebas DGI
# produccion   → ambiente real DGI
DGI_MODE=mock

# ── Credenciales DGI (solo cuando DGI_MODE != mock) ───────────────────────────
DGI_USUARIO=
DGI_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ── Contraseña de acceso a la aplicación ──────────────────────────────────────
APP_PASSWORD=factura2024
